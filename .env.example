# ==============================================================================
# CivicLoopAI Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and customize it according to your environment:
#   cp .env.example .env
#
# DO NOT commit real API keys, passwords, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Application Settings
# ------------------------------------------------------------------------------
# Host interface to bind the API server (0.0.0.0 for docker/external, 127.0.0.1 for local)
HOST=127.0.0.1

# Port number to listen on
PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# SQLAlchemy database connection string.
# SQLite (default for development/testing):
CIVICLOOP_DATABASE_URL=sqlite:///civicloop.db

# PostgreSQL (recommended for staging/production):
# CIVICLOOP_DATABASE_URL=postgresql+psycopg2://civic_user:civic_password@localhost:5432/civicloop_db


# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing and validating HMAC bearer auth tokens.
# MUST be replaced with a cryptographically secure random string of >= 32 characters in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
CIVICLOOP_AUTH_SECRET=replace-with-a-random-32-character-secret

# Sign-in lifetime in seconds (default: 43200 = 12 hours, a working shift)
CIVICLOOP_TOKEN_TTL_SECONDS=43200

# Set to "production" to refuse to start without CIVICLOOP_AUTH_SECRET
CIVICLOOP_ENV=development

# Platform administrators: comma-separated emails of ADMIN accounts that may see every city,
# confirm or merge cities, and step into any city. Leave empty for none.
CIVICLOOP_PLATFORM_ADMINS=


# ------------------------------------------------------------------------------
# 4. AI & Vision Provider Configuration
# ------------------------------------------------------------------------------
# Active AI provider for incident image analysis and metadata extraction.
# Options: 'gemini' | 'open_weight' (or 'open-weight')
CIVICLOOP_AI_PROVIDER=gemini

# --- Google Gemini Settings (used when CIVICLOOP_AI_PROVIDER=gemini) ---
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Open-Weight / OpenAI-Compatible Provider Settings ---
# Used when CIVICLOOP_AI_PROVIDER=open_weight (e.g., vLLM, Ollama, LiteLLM, TGI)
OPEN_WEIGHT_ENDPOINT=http://localhost:8000/v1
OPEN_WEIGHT_MODEL=replace-with-open-weight-model
# Optional API key for open-weight proxy / provider if authentication is required
OPEN_WEIGHT_API_KEY=


# --- Machine learning ---
# Where trained risk models are kept (one sub-folder per city)
CIVICLOOP_MODEL_DIR=./var/models
# "off" skips downloading the sentence-embedding model (duplicate matching falls back to word overlap)
# CIVICLOOP_EMBEDDINGS=off


# ------------------------------------------------------------------------------
# 5. Media & Object Storage Configuration
# ------------------------------------------------------------------------------
# Storage backend for incident images, audit attachments, and evaluation datasets.
# Options:
#   'local'  - Local filesystem storage (default for standalone development)
#   'memory' - In-memory ephemeral storage (ideal for unit/integration tests)
#   's3'     - S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, Ceph)
CIVICLOOP_STORAGE_BACKEND=local

# Local storage filesystem root path (used when CIVICLOOP_STORAGE_BACKEND=local)
CIVICLOOP_STORAGE_ROOT=./var/uploads

# --- S3 / MinIO / Cloudflare R2 Settings (used when CIVICLOOP_STORAGE_BACKEND=s3) ---
CIVICLOOP_STORAGE_BUCKET=civicloop-media-bucket
CIVICLOOP_STORAGE_REGION=us-east-1

# Custom endpoint URL for MinIO, LocalStack, or Cloudflare R2.
# Leave blank for standard AWS S3.
CIVICLOOP_STORAGE_ENDPOINT=
# CIVICLOOP_STORAGE_ENDPOINT=http://localhost:9000

# S3 Access Credentials:
# CivicLoopAI supports both CIVICLOOP_STORAGE_* prefix and standard AWS_* variables.
CIVICLOOP_STORAGE_ACCESS_KEY=
CIVICLOOP_STORAGE_SECRET_KEY=

# Standard AWS credentials (supported natively by boto3 fallback):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 6. Background Worker & Asynchronous Job Queue
# ------------------------------------------------------------------------------
# Job queue broker used for dispatching background tasks (AI analysis, duplicate
# detection, hotspot risk assessment, route planning, municipal sync).
# Options:
#   'memory' - Synchronous in-memory queue (default for simple local runs & tests)
#   'redis'  - Redis broker with priority queues (recommended for multi-process/production)
CIVICLOOP_QUEUE_BACKEND=memory

# Redis broker URL (required when CIVICLOOP_QUEUE_BACKEND=redis)
CIVICLOOP_REDIS_URL=redis://localhost:6379/0