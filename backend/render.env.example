# ==============================================================================
# CivicLoopAI on Render with Supabase: paste this into Render > Environment > "Add from .env"
# ==============================================================================
# Replace every PASTE_... value (or delete its line) before saving. Do not commit the filled-in copy.
# Render sets PORT itself, so there is no PORT line here.
# ==============================================================================

# --- required -----------------------------------------------------------------
CIVICLOOP_ENV=production
# A long random string. Make one with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
CIVICLOOP_AUTH_SECRET=PASTE_A_LONG_RANDOM_SECRET
# Supabase > Connect > SESSION POOLER address (not the "Direct connection" one, which is IPv6 only).
# If the password has characters like @ / : # write them percent-encoded (@ is %40).
CIVICLOOP_DATABASE_URL=PASTE_SUPABASE_SESSION_POOLER_URL
# One API process with the built-in job worker (jobs are re-queued from the database after a restart).
CIVICLOOP_ALLOW_SINGLE_PROCESS=1
# The admin email(s) allowed to manage every city. Create that account with: uv run python -m civicloop.make_admin
CIVICLOOP_PLATFORM_ADMINS=PASTE_YOUR_ADMIN_EMAIL

# --- photo storage: Supabase Storage over its S3 interface (a private bucket) ----
CIVICLOOP_STORAGE_BACKEND=s3
CIVICLOOP_STORAGE_BUCKET=PASTE_BUCKET_NAME
CIVICLOOP_STORAGE_ENDPOINT=https://PASTE_PROJECT_REF.supabase.co/storage/v1/s3
CIVICLOOP_STORAGE_REGION=PASTE_PROJECT_REGION_FOR_EXAMPLE_ap-southeast-1
CIVICLOOP_STORAGE_ACCESS_KEY=PASTE_S3_ACCESS_KEY
CIVICLOOP_STORAGE_SECRET_KEY=PASTE_S3_SECRET_KEY

# --- AI photo analysis (the rest of the app works without it) -------------------
CIVICLOOP_AI_PROVIDER=gemini
GEMINI_API_KEY=PASTE_A_NEW_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- sensible defaults ----------------------------------------------------------
# Skip the sentence-embedding download on a small instance (duplicate matching falls back to word overlap).
CIVICLOOP_EMBEDDINGS=off
CIVICLOOP_TOKEN_TTL_SECONDS=43200
CIVICLOOP_LOGIN_ATTEMPTS=8
CIVICLOOP_REGISTER_LIMIT=60
CIVICLOOP_DB_POOL_SIZE=5
CIVICLOOP_DB_MAX_OVERFLOW=5
# Only needed if you build with pip instead of uv:
# PYTHON_VERSION=3.12.8
