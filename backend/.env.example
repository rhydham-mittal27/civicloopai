# ==============================================================================
# CivicLoopAI settings for running on your own computer (.env.example)
# ==============================================================================
# Copy to '.env' (cp .env.example .env). Every line here is optional: with none of them set the app runs on a
# local SQLite file, keeps photos in ./var/uploads, and turns AI analysis off.
#
# Deploying to Render + Supabase? Use render.env.example instead: it is the one to paste into Render.
# Never commit real keys or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
CIVICLOOP_DATABASE_URL=sqlite:///civicloop.db
# PostgreSQL / Supabase (for Supabase use the SESSION POOLER address from Connect, not the direct one, which is IPv6 only):
# CIVICLOOP_DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# postgres:// and postgresql:// addresses are both accepted. A small pool suits hosted databases:
# CIVICLOOP_DB_POOL_SIZE=5
# CIVICLOOP_DB_MAX_OVERFLOW=5

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Signs sign-in tokens. Leave unset in development (a random one is made each start, so sign-ins end on restart).
# REQUIRED in production, 32+ random characters:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# CIVICLOOP_AUTH_SECRET=

# "production" refuses to start without a real secret, with in-memory photo storage, with an in-process queue
# (unless CIVICLOOP_ALLOW_SINGLE_PROCESS=1), or on an out-of-date database.
CIVICLOOP_ENV=development

# Sign-in lifetime in seconds (43200 = 12 hours, a working shift)
CIVICLOOP_TOKEN_TTL_SECONDS=43200
# Throttles on the public sign-in and sign-up routes (per process)
CIVICLOOP_LOGIN_ATTEMPTS=8
CIVICLOOP_REGISTER_LIMIT=60

# Admin emails that may see every city, confirm or merge cities, and step into any city (comma separated).
# These addresses cannot be claimed through the sign-up form: create them with `uv run python -m civicloop.make_admin`.
CIVICLOOP_PLATFORM_ADMINS=

# ------------------------------------------------------------------------------
# AI photo analysis (leave CIVICLOOP_AI_PROVIDER unset to switch it off)
# ------------------------------------------------------------------------------
# CIVICLOOP_AI_PROVIDER=gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or any OpenAI-compatible server (vLLM, Ollama, LiteLLM ...):
# CIVICLOOP_AI_PROVIDER=open_weight
# OPEN_WEIGHT_ENDPOINT=http://localhost:11434/v1
# OPEN_WEIGHT_MODEL=
# OPEN_WEIGHT_API_KEY=

# ------------------------------------------------------------------------------
# Machine learning
# ------------------------------------------------------------------------------
# Where trained risk models are kept (one sub-folder per city)
CIVICLOOP_MODEL_DIR=./var/models
# "off" skips the sentence-embedding model (duplicate matching falls back to word overlap)
# CIVICLOOP_EMBEDDINGS=off

# ------------------------------------------------------------------------------
# Photo storage
# ------------------------------------------------------------------------------
# local  = files on this computer (default)    memory = nothing kept (tests only; refused in production)
# s3     = any S3-compatible bucket: AWS S3, Supabase Storage, Cloudflare R2, MinIO
CIVICLOOP_STORAGE_BACKEND=local
CIVICLOOP_STORAGE_ROOT=./var/uploads

# For s3, uncomment and fill in:
# CIVICLOOP_STORAGE_BUCKET=
# CIVICLOOP_STORAGE_REGION=us-east-1
# CIVICLOOP_STORAGE_ENDPOINT=http://localhost:9000        # leave out for AWS S3; Supabase: https://<project-ref>.supabase.co/storage/v1/s3
# CIVICLOOP_STORAGE_ACCESS_KEY=
# CIVICLOOP_STORAGE_SECRET_KEY=
# (the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY variables also work)

# ------------------------------------------------------------------------------
# Background jobs
# ------------------------------------------------------------------------------
# memory = built-in worker inside the API process (fine for one process; jobs are re-queued from the database after a restart)
# redis  = a shared queue, with a separate worker: uv run python -m civicloop.worker
CIVICLOOP_QUEUE_BACKEND=memory
# CIVICLOOP_REDIS_URL=redis://localhost:6379/0
# Needed to run production with the in-process queue (see render.env.example):
# CIVICLOOP_ALLOW_SINGLE_PROCESS=1
